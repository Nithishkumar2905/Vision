# ============================================================================
# ACCESSPREP-X — Environment Configuration Template
# Copy this file to .env and replace placeholder values with your configuration
# ============================================================================

# Server Runtime Configuration
PORT=3000
NODE_ENV=development
DISABLE_HMR=false

# AI Tutor & Speech Intelligence (Google Gemini API)
# Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application Base URL
APP_URL="http://localhost:3000"

# PostgreSQL Database Configuration (Optional — falls back to JSON file store when unset)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accessprep_x"
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD=""
PGDATABASE="accessprep_x"
PGSSLMODE="disable"